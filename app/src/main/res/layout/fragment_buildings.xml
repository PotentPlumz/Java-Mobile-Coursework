<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".BuildingsFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/NTU_Colour_Light_Grey"
        android:background="@color/NTU_Colour_Light_Grey"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="10dp"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="Explored Buildings:"
                >
            </TextView>
            <TextView
                android:id="@+id/explored_buildings_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="30dp"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="X/X"
                >
            </TextView>
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            >

        </Button>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-30dp"
            app:cardCornerRadius="35dp"
            >
            <ListView
                android:id="@+id/image_custom_listview"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="10dp"
                android:layout_width="409dp"
                android:layout_height="729dp"

                >

            </ListView>
        </androidx.cardview.widget.CardView>


    </LinearLayout>


</FrameLayout>