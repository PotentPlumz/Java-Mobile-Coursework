<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/NTU_Colour_Light_Grey"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/NTU_gif"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_marginTop="-60dp"
        android:alpha="0.75"
        android:src="@drawable/video_turned_to_gif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/NTU_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ntu_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="610dp"
        android:layout_marginBottom="-30dp"
        app:cardCornerRadius="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="393dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="248dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingVertical="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="30dp"
                android:text="Register"
                android:textColor="@color/NTU_Colour_Pink"
                android:textSize="25dp"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="20dp"
                android:text="First Name"
                android:textColor="@color/NTU_Colour_Grey"
                android:textSize="14dp"
                android:textStyle="bold">
            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <EditText
                    android:id="@+id/edittext_firstname_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="1dp"
                    android:maxLength="32"
                    android:lines="1"
                    android:inputType="textPersonName"
                    android:textSize="12dp"
                    android:layout_marginHorizontal="30dp"
                    android:textColor="@color/NTU_Colour_Grey"
                    >
                </EditText>


            </com.google.android.material.textfield.TextInputLayout>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="5dp"
                android:text="Last Name"
                android:textColor="@color/NTU_Colour_Grey"
                android:textSize="14dp"
                android:textStyle="bold">

            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <EditText
                    android:id="@+id/edittext_lastname_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_gravity="top"
                    android:maxLength="32"
                    android:inputType="textPersonName"
                    android:textSize="12dp"
                    android:layout_marginHorizontal="30dp"
                    android:textColor="@color/NTU_Colour_Grey"
                    >
                </EditText>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="5dp"
                android:text="Email"
                android:textColor="@color/NTU_Colour_Grey"
                android:textSize="14dp"
                android:textStyle="bold">
            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <EditText
                    android:id="@+id/edittext_email_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="1dp"
                    android:textSize="12dp"
                    android:inputType="textEmailAddress"
                    android:layout_marginHorizontal="30dp"
                    android:textColor="@color/NTU_Colour_Grey"
                    >
                </EditText>


            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="5dp"
                android:text="Password"
                android:textColor="@color/NTU_Colour_Grey"
                android:textSize="14dp"
                android:textStyle="bold">

            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                >

                <EditText
                    android:id="@+id/edittext_password1_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="1dp"
                    android:layout_marginHorizontal="30dp"
                    android:textSize="12dp"
                    android:preferKeepClear="true"
                    android:inputType="textPassword"
                    android:textColor="@color/NTU_Colour_Grey"
                    >

                </EditText>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="5dp"
                android:text="Confirm Password"
                android:textColor="@color/NTU_Colour_Grey"
                android:textSize="14dp"
                android:textStyle="bold">

            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                >

                <EditText
                    android:id="@+id/edittext_password2_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="1dp"
                    android:textSize="12dp"
                    android:layout_marginHorizontal="30dp"
                    android:inputType="textPassword"
                    android:textColor="@color/NTU_Colour_Grey"
                    >

                </EditText>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/Register_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Register"
                android:layout_marginHorizontal="30dp"
                android:backgroundTint="@color/NTU_Colour_Pink"
                ></Button>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="30dp"
                    android:text="Already have an account?"
                    android:textColor="@color/NTU_Colour_Grey"
                    android:textSize="14dp"
                    android:textStyle="bold">

                </TextView>

                <TextView
                    android:layout_width="80dp"
                    android:id="@+id/move_to_login_textview"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginLeft="10dp"
                    android:text="Click Here"
                    android:textColor="@color/NTU_Colour_Blue"
                    android:textSize="14dp"
                    android:textStyle="bold">

                </TextView>



            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="300dp"
                android:textColor="@color/white"
                android:text="bob"
                >
            </TextView>



        </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>